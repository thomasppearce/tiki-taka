# Copy to .env and fill in from the infra deployment outputs (infra/README.md).
# Authentication is Microsoft Entra ID (az login locally, managed identity in Azure): no keys.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=agents
FOUNDRY_MODEL_LABEL=gpt-5.4-mini  # shown in the control room; the deployment's model
FOUNDRY_EMBEDDING_MODEL=embeddings
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# Matchday clock (optional): the minute it starts at, and its speed.
MATCH_START_MINUTE=55
MATCH_SPEED=1
